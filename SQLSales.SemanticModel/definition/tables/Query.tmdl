	partition Query = m
		mode: import
		source =
				let
				  Source = Sql.Database(".\SQLEXPRESS", "AdventureWorksDW2025", [Query = "SELECT#(lf)    cust.CustomerKey,#(lf)    cust.FirstName,#(lf)    cust.LastName,#(lf)    cust.EmailAddress,#(lf)    res.ResellerKey,#(lf)    res.ResellerName,#(lf)    geo.City,#(lf)    geo.StateProvinceName,#(lf)    geo.EnglishCountryRegionName,#(lf)    sales.ProductKey,#(lf)    sales.OrderDateKey,#(lf)    sales.SalesOrderNumber,#(lf)    sales.SalesOrderLineNumber,#(lf)    sales.OrderQuantity,#(lf)    sales.UnitPrice,#(lf)    sales.SalesAmount,#(lf)    prod.EnglishProductName,#(lf)    prod.Color,#(lf)    prod.ListPrice,#(lf)    prod.ModelName#(lf)#(lf)  FROM [AdventureWorksDW2025].[dbo].[FactResellerSales] sales#(lf)#(lf)  JOIN [AdventureWorksDW2025].[dbo].[DimProduct] prod#(lf)#(lf)  ON prod.ProductKey = sales.ProductKey#(lf)#(lf)  JOIN [AdventureWorksDW2025].[dbo].[FactInternetSales] fs#(lf)#(lf)  ON fs.ProductKey = sales.ProductKey#(lf)  #(lf)  JOIN [AdventureWorksDW2025].[dbo].[DimCustomer] cust#(lf)#(lf)  ON cust.CustomerKey = fs.CustomerKey#(lf)#(lf)  join [AdventureWorksDW2025].[dbo].[DimGeography] geo#(lf)#(lf)  ON cust.GeographyKey = geo.GeographyKey#(lf)#(lf)  join [AdventureWorksDW2025].[dbo].[DimReseller] res#(lf)#(lf)  ON res.ResellerKey = sales.ResellerKey #(lf)  #(lf)  ;#(lf)  "])
				in
				  Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

