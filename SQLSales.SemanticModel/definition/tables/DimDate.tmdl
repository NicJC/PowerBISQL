	partition DimDate = calculated
		mode: import
		source = ```
				
				VAR MinDate = MIN(OrderFacts[OrderDate])
				VAR MaxDate = MAX(OrderFacts[OrderDate])
				RETURN
				ADDCOLUMNS (
				    CALENDAR (MinDate, MaxDate),
				    "Year", YEAR([Date]),
				    "Month", FORMAT([Date], "MMMM"),
				    "MonthNum", MONTH([Date]),
				    "Quarter", "Q" & FORMAT([Date], "Q"),
				    "MonthShort", FORMAT([Date], "MMM"),
				    "MonthSort", YEAR([Date]) * 100 + MONTH([Date])
				)
				
				```

	annotation PBI_Id = ed1acc586df74ad59ddc6854b825afa2

