table MeasureTbl
	lineageTag: 1ace61a9-afa3-4cd0-93ac-2c4215a2e2e8

	measure 'Unit Price' = DISTINCT(OrderFacts[UnitPrice])
		lineageTag: be881785-5956-4f1d-86f8-f19a77329913

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure MinQty = MIN(OrderFacts[OrderQuantity]) + 3
		formatString: 0
		lineageTag: 0ca97865-0dc8-4081-a670-701124bf7cac

	measure OrderQuantity = values(OrderFacts[OrderQuantity])
		formatString: 0
		lineageTag: e67b7bf2-e86e-4570-94f5-1fb28edfb91c

	measure Outliers = ```
			
			CALCULATE (   
			           [OrderQuantity],
			    FILTER (
			        VALUES ( 'Product'[ProductName] ),
			        COUNTROWS (
			            FILTER (
			                OrderFacts,
			                [OrderQuantity] >= [MinQty]
			            )
			        ) > 0
			    )
			)
			```
		formatString: 0
		lineageTag: 6873db5e-8001-4780-b5c6-08a06e0537ff

	partition MeasureTbl = m
		mode: import
		source =
				let
				  Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Removed Columns" = Table.RemoveColumns(Source,{"Column1"})
				in
				  #"Removed Columns"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

